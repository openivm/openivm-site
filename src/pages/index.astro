---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProductIcon from '../components/ProductIcon.astro';
import SectionIcon from '../components/SectionIcon.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'OpenIVM',
      url: 'https://openivm.org/',
    },
    {
      '@type': 'SoftwareSourceCode',
      name: 'OpenIVM',
      description:
        'Open-source incremental view maintenance (IVM) compiler that turns SQL materialized views into incremental SQL for DuckDB and Apache Spark.',
      url: 'https://openivm.org/',
      codeRepository: 'https://github.com/openivm/openivm',
      programmingLanguage: ['C++', 'SQL'],
      runtimePlatform: ['DuckDB', 'Apache Spark'],
      license: 'https://opensource.org/licenses/MIT',
      keywords: [
        'incremental view maintenance',
        'IVM',
        'materialized views',
        'DuckDB',
        'DuckDB extension',
        'Apache Spark',
        'data pipelines',
        'dbt',
        'incremental refresh',
        'DuckLake',
      ],
      sourceOrganization: { '@type': 'Organization', name: 'CWI', url: 'https://www.cwi.nl/' },
      citation: {
        '@type': 'ScholarlyArticle',
        name: 'OpenIVM: a SQL-to-SQL Compiler for Incremental Computations',
        url: 'https://dl.acm.org/doi/10.1145/3626246.3654743',
      },
    },
  ],
};

const pillars = [
  {
    n: '01',
    title: 'Rigor',
    body: 'Delta rules come from each operator\'s algebra (Z-sets, as in DBSP), not pattern matching: a view is maintained exactly, or classified up front for full refresh.',
    tag: 'Z-sets · delta rules',
  },
  {
    n: '02',
    title: 'State',
    body: 'View and auxiliary state live in ordinary tables, so it works on batch tables, not only streams, and survives restarts.',
    tag: 'aux state · delta tables',
  },
  {
    n: '03',
    title: 'Deletes',
    body: 'Every change is a signed tuple (+1 or −1), so inserts, updates and deletes share one algebra instead of special cases.',
    tag: '+1 / −1 multiplicities',
  },
];
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />

  <section id="why" class="problem">
    <div class="container problem-grid">
      <h2 class="heading-icon"><SectionIcon name="cost" large /><span>Batch ETL costs scale with your <strong class="historical">historical<svg class="word-flame" viewBox="0 0 18 24" aria-hidden="true"><path d="M9 1C9 7 3 8 3 15a6 6 0 0 0 12 0c0-4-2-6-4-8 .2 3-1 4-2 4 1-3 0-7 0-10Z" fill="#ff6379" /><path d="M9 12c0 3-2 3-2 5a2 2 0 0 0 4 0c0-2-1-3-2-5Z" fill="#ffd7dc" /></svg></strong> data. They should scale with your <em class="changed">changed</em> data.</span></h2>
      <div class="problem-body">
        <p>
          LLMs and tools like dbt generate more data pipelines than ever, and most of them recompute from scratch on
          every run, while lakehouse ETL workloads often lack efficient incremental refresh.
        </p>
        <p class="strong">
          OpenIVM is an open-source incremental view maintenance (IVM) compiler that makes those pipelines refresh only
          what changed, inside the engines you already run.
        </p>
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="container">
      <div class="section-head">
        <h2 class="heading-icon"><SectionIcon name="engine" large /><span>What an IVM engine needs, done properly.</span></h2>
      </div>
      <div class="pillars">
        {
          pillars.map((p) => (
            <article class="card pillar">
              <span class="n">{p.n}</span>
              <h3 class="heading-icon"><SectionIcon name={p.title === 'Rigor' ? 'rigor' : p.title === 'State' ? 'state' : 'deletes'} /><span>{p.title}</span></h3>
              <p>{p.body}</p>
              <span class="pill">{p.tag}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="explore">
    <div class="container explore-grid">
      <a class="card explore-card" href="/how-it-works/">
        <h3 class="heading-icon"><SectionIcon name="internals" /><span>How it works</span></h3>
        <p>The Z-set model, the architecture, and the exact SQL OpenIVM generates for a refresh.</p>
        <span class="go">Read the internals →</span>
      </a>
      <a class="card explore-card" href="/quickstart/">
        <h3 class="heading-icon"><SectionIcon name="quickstart" /><span>Quickstart</span></h3>
        <p>Build the DuckDB or Spark extension, create a materialized view, and refresh only the change.</p>
        <span class="go">Get started →</span>
      </a>
      <a class="card explore-card" href="/compare/">
        <h3 class="heading-icon"><SectionIcon name="compare" /><span>Compare</span></h3>
        <p>How OpenIVM differs from pg_ivm, streaming databases, and warehouse materialized views.</p>
        <span class="go">See the comparison →</span>
      </a>
    </div>
  </section>

  <section id="engines">
    <div class="container">
      <div class="section-head">
        <h2 class="heading-icon"><SectionIcon name="engine" large /><span>One compiler, many engines.</span></h2>
      </div>
      <div class="engines">
        <article class="card engine">
          <div class="engine-top"><div class="engine-name"><ProductIcon product="duckdb" /><h3>DuckDB</h3></div><span class="pill ok">available · source build</span></div>
          <p>
            The reference implementation: incremental materialized views in DuckDB, with automatic refresh, cascading
            pipelines, an adaptive cost model and DuckLake integration.
          </p>
          <a href="/quickstart/#local-duckdb">DuckDB quickstart →</a>
          <a href="https://github.com/openivm/openivm">github.com/openivm/openivm →</a>
        </article>
        <article class="card engine">
          <div class="engine-top"><div class="engine-name"><ProductIcon product="spark" /><ProductIcon product="fabric" /><h3>Apache Spark</h3></div><span class="pill ok">available · source build</span></div>
          <p>
            Incremental refresh for Spark ETL and dbt models, including Spark-dialect view bodies such as{' '}
            <code>VERSION AS OF</code>.
          </p>
          <a href="/quickstart/#local-spark">Spark quickstart →</a>
          <a href="/quickstart/#fabric-spark">Fabric Spark quickstart →</a>
          <a href="https://github.com/openivm/openivm-spark">github.com/openivm/openivm-spark →</a>
        </article>
        <article class="card engine">
          <div class="engine-top"><h3 class="heading-icon"><SectionIcon name="engine" /><span>Your engine</span></h3><span class="pill">open standard</span></div>
          <p>
            OpenIVM emits SQL, not engine internals. If your engine speaks SQL and can store a table, it can host
            an incremental view.
          </p>
          <a href="https://github.com/openivm/openivm/issues">Propose an integration →</a>
        </article>
      </div>
    </div>
  </section>

  <section id="benchmark" class="bench">
    <div class="container bench-grid">
      <div>
        <h2 class="heading-icon"><SectionIcon name="benchmark" large /><span>Open, reproducible numbers.</span></h2>
        <p class="lede">
          A live benchmark fed by <code>ivm-bench</code>: incremental refresh versus full recompute across engines,
          workloads and delta sizes. Results are published as a static Parquet file and rendered right in your
          browser.
        </p>
        <a class="btn" style="margin-top:22px" href="/benchmark/">Explore the benchmark →</a>
      </div>
      <a class="card bench-preview" href="/benchmark/">
        <span class="pill ok">live benchmark</span>
        <h3 class="heading-icon"><SectionIcon name="benchmark" /><span>Explore performance across engines and commits.</span></h3>
        <span class="go">View the dashboard →</span>
      </a>
    </div>
  </section>

  <section class="research">
    <div class="container">
      <div class="card paper">
        <h3 class="heading-icon"><SectionIcon name="paper" />
          <a href="https://dl.acm.org/doi/10.1145/3626246.3654743"
            >OpenIVM: a SQL-to-SQL Compiler for Incremental Computations</a
          >
        </h3>
        <p class="muted">SIGMOD Companion 2024 · doi:10.1145/3626246.3654743</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .muted {
    color: var(--muted);
  }
  .heading-icon { display:grid; grid-template-columns:auto minmax(0, 1fr); align-items:start; column-gap:16px; }
  h2.heading-icon > span:not(:global(.section-icon)) { padding-top:8px; }
  h3.heading-icon { column-gap:12px; }
  h3.heading-icon > :not(:global(.section-icon)) { padding-top:10px; }
  .historical, .changed { position:relative; display:inline-block; margin-right:.08em; font-style:italic; }
  .historical { color:#ff8493; text-shadow:0 0 18px rgba(255,73,91,.42); animation:heat-glow 3.2s ease-in-out infinite; }
  .word-flame { display:inline-block; width:.45em; height:.65em; margin-left:.07em; vertical-align:-.05em; filter:drop-shadow(0 0 5px rgba(255,83,104,.7)); transform-origin:50% 100%; animation:word-flame 2.4s ease-in-out infinite; pointer-events:none; }
  .changed { color:#d5b9ff; text-shadow:0 0 18px rgba(178,132,255,.55); animation:violet-glow 3.8s ease-in-out infinite; }
  @keyframes word-flame { 0%,100% { transform:scale(1); } 50% { transform:scale(.88,1.1); } }
  @keyframes heat-glow { 0%,100% { text-shadow:0 0 12px rgba(255,73,91,.32); } 50% { text-shadow:0 0 22px rgba(255,73,91,.65); } }
  @keyframes violet-glow { 0%,100% { text-shadow:0 0 12px rgba(178,132,255,.38); } 50% { text-shadow:0 0 24px rgba(178,132,255,.7); } }
  @media (prefers-reduced-motion:reduce) { .historical, .changed, .word-flame { animation:none; } }

  .problem {
    border-top: 1px solid var(--border);
  }
  .problem-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .problem-body {
    display: grid;
    gap: 18px;
    color: var(--muted);
    font-size: 1.08rem;
  }
  .problem-body .strong {
    color: var(--text);
    font-weight: 500;
  }

  .pillars-section {
    padding-top: 0;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .pillar {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 0.97rem;
    flex: 1;
  }
  .pillar .pill {
    align-self: flex-start;
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--faint);
  }
  .pillar h3 {
    font-size: 1.5rem;
  }
  .pillar:nth-child(1) h3 {
    color: var(--accent);
  }
  .pillar:nth-child(2) h3 {
    color: var(--accent-2);
  }
  .pillar:nth-child(3) h3 {
    color: var(--insert);
  }

  .explore {
    padding-top: 0;
  }
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .explore-card {
    padding: 32px;
    display: grid;
    gap: 12px;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .explore-card:hover {
    text-decoration: none;
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .explore-card h3 {
    font-size: 1.35rem;
  }
  .explore-card p {
    color: var(--muted);
  }
  .go {
    color: var(--insert);
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: 6px;
  }

  #engines {
    border-top: 1px solid var(--border);
  }
  .engines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .engine {
    padding: 26px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .engine-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .engine-name { display: flex; align-items: center; gap: 10px; --product-icon-size:44px; --product-glyph-size:29px; }
  .engine p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .engine a,
  .engine .muted {
    font-size: 0.9rem;
  }

  .bench {
    border-top: 1px solid var(--border);
  }
  .bench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .bench-preview {
    display: grid;
    justify-items: start;
    gap: 18px;
    padding: 32px;
    color: var(--text);
  }
  .bench-preview:hover {
    text-decoration: none;
    border-color: var(--border-strong);
  }

  .research {
    padding-top: 0;
  }
  .paper {
    padding: 32px;
  }
  .paper h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .paper h3 a {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .problem-grid,
    .bench-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .pillars,
    .engines,
    .explore-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
