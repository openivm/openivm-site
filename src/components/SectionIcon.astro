---
type Name = 'cost' | 'engine' | 'rigor' | 'state' | 'deletes' | 'internals' | 'quickstart' | 'compare' | 'benchmark' | 'paper';
interface Props { name: Name; large?: boolean }
const { name, large = false } = Astro.props;
const paths: Record<Exclude<Name, 'cost'>, string> = {
  engine: 'M4 8 12 4l8 4-8 4-8-4Zm0 4 8 4 8-4M4 16l8 4 8-4',
  rigor: 'M12 3 4 6v5c0 5 3 8 8 10 5-2 8-5 8-10V6l-8-3Zm-3 9 2 2 4-4',
  state: 'M4 6c0-3 16-3 16 0s-16 3-16 0Zm0 0v12c0 3 16 3 16 0V6M4 12c0 3 16 3 16 0',
  deletes: 'M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13M10 10v7m4-7v7',
  internals: 'M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.2 2.2m8.4 8.4 2.2 2.2m0-12.8-2.2 2.2m-8.4 8.4-2.2 2.2M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  quickstart: 'M5 4h14v16H5zM8 8l3 3-3 3m5 1h3',
  compare: 'M4 6h12m-3-3 3 3-3 3M20 18H8m3-3-3 3 3 3',
  benchmark: 'M4 20V10m5 10V4m5 16v-7m5 7V7M3 20h18',
  paper: 'M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 15h7M9 18h5',
};
---
<span class:list={['section-icon', name, { large }]} aria-hidden="true">
  {name === 'cost' ? (
    <svg viewBox="0 0 64 64" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M23 20 18 10l8 3 6-7 6 7 8-3-5 10" fill="#6c4798" stroke="#d4b8ff" stroke-width="2.4" />
      <path d="M22 22h20c6 5 11 12 11 22 0 8-5 12-13 12H24c-8 0-13-4-13-12 0-10 5-17 11-22Z" fill="#5b398c" stroke="#d4b8ff" stroke-width="2.4" />
      <path d="M21 21h22" stroke="#f6c2ff" stroke-width="3" />
      <path d="M32 29v20m6-16h-9a4 4 0 0 0 0 8h6a4 4 0 0 1 0 8h-9" stroke="#fff1ff" stroke-width="2.6" />
      <g class="flame">
        <path d="M45 23c-1-5 2-8 4-11 0 4 5 5 5 10 0 4-2 6-5 6-2 0-4-2-4-5Z" fill="#ff72c6" stroke="#ffd0ea" stroke-width="1.8" />
        <path d="M48 24c0-2 1-3 2-5 0 2 2 3 2 5a2 2 0 0 1-4 0Z" fill="#fff1ff" stroke="none" />
      </g>
      <g class="embers" fill="#ffb5e3" stroke="none"><circle cx="55" cy="12" r="1.5" /><circle cx="46" cy="6" r="1.1" /></g>
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d={paths[name]} />
      <circle class="accent-dot" cx="19.5" cy="4.5" r="1.5" fill="#ff9ed8" stroke="none" />
    </svg>
  )}
</span>
<style>
  .section-icon { --icon-size:48px; display:inline-grid; place-items:center; flex:none; width:var(--icon-size); height:var(--icon-size); border:1px solid #564477; border-radius:14px; color:#d5c1ff; background:radial-gradient(circle at 30% 20%, #453362, #20162f 75%); box-shadow:inset 0 1px rgba(255,255,255,.07); }
  .section-icon.large { --icon-size:64px; border-radius:18px; }
  svg { display:block; width:34px; height:34px; overflow:visible; }
  .large svg { width:46px; height:46px; }
  .cost svg { width:56px; height:56px; }
  .accent-dot { animation:glint 4s ease-in-out infinite; transform-origin:19.5px 4.5px; }
  .flame { transform-origin:50px 27px; animation:flicker 2.2s ease-in-out infinite; }
  .embers { animation:embers 2.2s ease-in-out infinite; }
  @keyframes flicker { 0%,100% { transform:scale(1); } 45% { transform:scale(.88,1.12); } 70% { transform:scale(1.05,.95); } }
  @keyframes embers { 0%,100% { opacity:.35; transform:translateY(1px); } 50% { opacity:1; transform:translateY(-2px); } }
  @keyframes glint { 0%,100% { opacity:.55; transform:scale(.8); } 50% { opacity:1; transform:scale(1.2); } }
  @media (max-width:640px) { .section-icon.large { --icon-size:54px; border-radius:15px; } .large svg { width:40px; height:40px; } .cost svg { width:50px; height:50px; } }
  @media (prefers-reduced-motion:reduce) { .flame, .embers, .accent-dot { animation:none; } }
</style>
