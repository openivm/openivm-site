---
interface Props { kind: 'check' | 'cross' }
const { kind } = Astro.props;
const check = kind === 'check';
const shape = check
  ? 'M8 28 15 21 24 30 42 11 49 18 24 44Z'
  : 'M14 9 25 20 36 9 43 16 32 27 43 38 36 45 25 34 14 45 7 38 18 27 7 16Z';
const colors = check
  ? { top: '#c4ffe4', face: '#47d694', side: '#166542', edge: '#a8ffda' }
  : { top: '#ffd0dd', face: '#f0657e', side: '#7d263f', edge: '#ffbbc9' };
---
<span class:list={['compare-mark', kind]} aria-hidden="true">
  <svg viewBox="0 0 56 56">
    <defs><linearGradient id={`compare-${kind}`} x1="0" y1="0" x2="0.8" y2="1"><stop stop-color={colors.top} /><stop offset=".45" stop-color={colors.face} /><stop offset="1" stop-color={colors.side} /></linearGradient></defs>
    <path d={shape} transform="translate(0 3)" fill={colors.side} />
    <path d={shape} fill={`url(#compare-${kind})`} stroke={colors.edge} stroke-width="1" stroke-linejoin="round" />
    <path d={check ? 'M9 28 15 22 24 31 42 12' : 'M8 16 14 10 25 21 36 10'} fill="none" stroke="#fff" stroke-opacity=".65" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</span>
<style>
  .compare-mark { display:grid; place-items:center; width:48px; height:48px; flex:none; }
  svg { display:block; width:48px; height:48px; filter:drop-shadow(0 3px 4px rgba(0,0,0,.32)); }
</style>
